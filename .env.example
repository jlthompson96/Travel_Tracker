NOTION_TOKEN=

# SHA-256 hex hash of your chosen site password (never the plaintext).
# Generate with: echo -n "yourpassword" | shasum -a 256
# Gates the UI. Leave unset for local dev to skip the password screen.
VITE_SITE_PASSWORD_HASH=

# The SAME password in PLAINTEXT. Gates api/notion/trip.ts, the write endpoint:
# on unlock the browser keeps the password and sends it as x-tt-token, and the
# handler compares it against this. Must match whatever you hashed above, or
# every edit will 401. Leave unset to make the deployment read-only.
TT_WRITE_SECRET=
