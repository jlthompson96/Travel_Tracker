{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022 for Array.prototype.at etc. The app targets iOS 17+ (see
    // PLAN_MOBILE.md), well past Safari 16.4 where these landed. `target` stays
    // ES2020 — this only widens the available types, it doesn't change output.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // src is browser code, so keep Node's globals out of it even though
    // @types/node is installed for api/. Without this, every @types/* package
    // is loaded globally and `process` would silently typecheck in components
    // where it doesn't exist at runtime. vite/client comes in through the
    // triple-slash reference in src/vite-env.d.ts, which this doesn't affect.
    "types": [],
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
